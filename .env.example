# ---------------------------------------------------------------------------
# ITV-Guest-app — пример конфигурации. Скопируй в .env: cp .env.example .env
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Базовый домен, от которого отрезается поддомен отеля.
# Гость приходит на crystal.guest.localhost -> subdomain = "crystal".
GUEST_APP_BASE_DOMAIN=guest.localhost
# Поддомены, которые НЕ являются отелями (платформенный уровень).
GUEST_APP_RESERVED_SUBDOMAINS=www,api,admin,platform,static,media

# --- PostgreSQL -----------------------------------------------------------
# Bootstrap-суперпользователь образа: инициализация и обслуживание.
# Приложение под ним НЕ работает — суперпользователь игнорирует RLS.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_DB=guestapp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Роль приложения: подчиняется RLS (FORCE ROW LEVEL SECURITY).
POSTGRES_USER=guestapp
POSTGRES_PASSWORD=guestapp
# Платформенная роль: BYPASSRLS. Миграции, сид, платформенный уровень.
POSTGRES_PLATFORM_USER=guestapp_platform
POSTGRES_PLATFORM_PASSWORD=guestapp_platform

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNELS_REDIS_URL=redis://redis:6379/3

# --- Стенд в локальной сети -------------------------------------------------
# Имя ЭТОЙ машины, по которому стенд открывают с телефона. Из него собирается
# публичный адрес медиа (см. docker-compose.yml): ссылки на картинки уходят
# КЛИЕНТУ, и `localhost` в них означает «телефон ищет MinIO у себя внутри».
#
# ИМЯ, А НЕ АДРЕС. mDNS-имя `<hostname>.local` раздаёт сама машина, и оно
# переживает смену сети, раздачу с телефона и перезагрузку роутера. IP-адрес не
# переживает ничего из этого: он уплывает, ссылки на картинки начинают вести в
# никуда, а витрина, получив ошибку загрузки, просто убирает картинку — так это
# и выглядит со стороны: «фотографии пропали».
#
# Своё имя: `scutil --get LocalHostName` (macOS), `hostname` (Linux).
#
#     DEV_HOST=MacBook-Pro-Oleg.local
#
# Если mDNS в сети не проходит (гостевой Wi-Fi с изоляцией клиентов,
# корпоративная сеть с фильтрацией multicast) — впишите IP машины и ЗАКРЕПИТЕ
# его за ней в роутере. Незакреплённый адрес придётся править после каждой
# смены сети, и узнаете вы об этом по исчезнувшим картинкам, а не по ошибке.
#
# `localhost` — если стенд открывают только на самой машине.
DEV_HOST=localhost

# --- MinIO ----------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
# MINIO_PUBLIC_ENDPOINT здесь НЕ задаётся: в dev его собирает docker-compose.yml
# из DEV_HOST и MINIO_HOST_PORT — иначе адрес пришлось бы править в двух местах,
# и одно из них всегда отставало бы.
MINIO_BUCKET=guest-media
MINIO_SECURE=0

# --- Auth -----------------------------------------------------------------
JWT_SECRET=dev-insecure-jwt-secret
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=14
GUEST_SESSION_TTL_HOURS=12

# --- Интеграционные швы (пока заглушки) -----------------------------------
PMS_ADAPTER=null
PAYMENT_ADAPTER=null

# --- Frontend -------------------------------------------------------------
VITE_API_PROXY=http://backend:8000

# --- Порты на хосте -------------------------------------------------------
# Внутри compose-сети сервисы всегда на своих стандартных портах. Наружу
# пробрасываем нестандартные, чтобы стенд не дрался за 5432/6379/9000 с
# другими проектами на той же машине.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
MINIO_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001
BACKEND_HOST_PORT=8010
FRONTEND_HOST_PORT=5183

# --- Почта -------------------------------------------------------------------
# Пароль администратора отеля уходит ЕМУ письмом, оператору платформы он не
# показывается. Поэтому почта — не «приятно бы», а условие работы консоли:
# без неё создание отеля и сброс пароля отказывают (503 mail_not_configured).
DEFAULT_FROM_EMAIL=noreply@guest.localhost
