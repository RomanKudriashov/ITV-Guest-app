{
  "backend_url": "ws://backend:8000/ws/v1/onprem/connector",
  "heartbeat_interval_s": 30,
  "max_concurrent_requests": 8,
  "version": "1.0.0-dev",

  "endpoints": {
    "iridi": {
      "baseUrl": "http://iridi-emulator:1085",
      "allowedMethods": ["GET", "POST"],
      "allowedPaths": ["/"],
      "timeoutMs": 3000,
      "maxRequestBytes": 8192,
      "maxResponseBytes": 65536,
      "followRedirects": false
    }
  }
}
