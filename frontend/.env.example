# Target for the Vite dev-server proxy (/api and /ws).
# In docker-compose use the backend service name, locally use localhost.
VITE_API_PROXY=http://localhost:8000
# Базовый домен платформы — та же величина, что APP_DOMAIN у бэкенда. По нему
# фронт делит адрес на корень (лендинг + консоль) и адрес отеля (гость + CMS).
# Пусто — режим одного хоста, см. docs/addressing.md.
VITE_APP_DOMAIN=
# Тенант для дева: в проде заголовок игнорируется, отель определяется хостом.
VITE_HOTEL_SUBDOMAIN=crystal
# Хосты, которые пропускает дев-сервер Vite (защита от DNS rebinding).
VITE_ALLOWED_HOSTS=.local,guest.localhost,.guest.localhost
