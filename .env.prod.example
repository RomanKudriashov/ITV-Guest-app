# ---------------------------------------------------------------------------
# Прод-конфигурация. НАСТОЯЩИЙ .env.prod живёт ТОЛЬКО на сервере и содержит
# сгенерированные секреты — в репозиторий не коммитится (см. .gitignore).
# Этот файл — шаблон с плейсхолдерами: секреты сгенерировать `openssl rand`.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ---------------------------------------------------------------------------

# --- Домен (единственная переменная для смены заглушки на реальный домен) ---
# Заглушка на sslip.io: <ip>.sslip.io резолвится в этот IP без всякой настройки
# DNS, включая любые поддомены. Тенант-поддомены: <hotel>.app.<ip>.sslip.io.
APP_DOMAIN=app.147.45.245.172.sslip.io

# --- Django ----------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=__GENERATE__          # openssl rand -hex 32
JWT_SECRET=__GENERATE__                 # openssl rand -hex 32
# Пока без TLS (nginx на :80) — ссылки/QR формируем по http. При включении
# TLS с реальным доменом сменить на https.
GUEST_APP_PUBLIC_SCHEME=http
GUEST_APP_RESERVED_SUBDOMAINS=www,api,admin,platform,static,media

# --- PostgreSQL (порт наружу НЕ публикуется) -------------------------------
POSTGRES_DB=guestapp
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
POSTGRES_USER=guestapp
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_PLATFORM_USER=guestapp_platform
POSTGRES_PLATFORM_PASSWORD=__GENERATE__

# --- MinIO (порт наружу НЕ публикуется; медиа отдаёт nginx) ----------------
MINIO_ROOT_USER=guestapp
MINIO_ROOT_PASSWORD=__GENERATE__
MINIO_BUCKET=guest-media
MINIO_SECURE=0
# Публичный адрес медиа = домен приложения; nginx проксирует /guest-media/.
MINIO_PUBLIC_ENDPOINT=app.147.45.245.172.sslip.io

# --- Сид ------------------------------------------------------------------
# Пусто = минимальный сид (только демо-отель, чтобы резолвился поддомен).
# Полный демо-контент приедет отдельным переносом данных.
SEED_ON_START=1
SEED_ARGS=

# --- Почта -------------------------------------------------------------------
# Пароль администратора отеля уходит ЕМУ письмом, оператору платформы он не
# показывается. Поэтому почта — не «приятно бы», а условие работы консоли:
# без неё создание отеля и сброс пароля отказывают (503 mail_not_configured).
DEFAULT_FROM_EMAIL=noreply@itv.local
# Логин и пароль веб-морды Mailpit в формате «имя:пароль».
# Порт наружу НЕ публикуется (см. docker-compose.prod.yml), это второй рубеж
# на случай, если его однажды опубликуют.
MAILPIT_UI_AUTH=mail:смените-этот-пароль

# --- Что читает система, но чего здесь не хватало ---------------------------
# Раздел добавлен вместе с книгой: сторож документации (`check-docs.mjs`)
# сверяет переменные из книги с ЭТИМ файлом, и оказалось, что образец знает
# меньше, чем настройки. Переменная, которой здесь нет, ничего не включает —
# и человек, выставивший её на сервере, ждал бы эффекта напрасно.
# Значения ниже — умолчания из `backend/config/settings.py`.

# Кэш: погода, схлопывание чтений оборудования, счётчик попыток PIN.
CACHE_URL=redis://redis:6379/4

# Почта. Без неё пароль администратору отеля отправить нечем, и заведение
# отеля честно откажет — это отказ, а не поломка.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=noreply@example.com

# Погода — единственный внешний источник, к которому ходит бэкенд сам.
WEATHER_PROVIDER=open-meteo
WEATHER_API_URL=https://api.open-meteo.com
WEATHER_REFRESH_SECONDS=1200
WEATHER_FRESH_SECONDS=2700

# Уведомления и эскалация.
NOTIFICATIONS_ENABLED=1
TELEGRAM_API_URL=https://api.telegram.org

# Доступ в консоль платформы. Второй фактор и список сетей — по готовности
# команды; включённый allowlist запирает всех, кто не в нём, включая вас.
PLATFORM_REQUIRE_2FA=0
PLATFORM_IP_ALLOWLIST=

# Версия API и дата отключения устаревших путей (пусто — не отключаем).
API_VERSION=v1
API_LEGACY_SUNSET=

# Связь с мобильным приложением. Включать ТОЛЬКО когда приложение существует:
# иначе ОС будет пытаться открыть то, чего нет.
APP_LINKS_ENABLED=0
IOS_APP_ID=TEAMID000.com.itvguest.app
ANDROID_PACKAGE=com.itvguest.app

# Ключ узла для коннектора, если он стоит на этом же сервере. Выдаётся в
# консоли платформы и переживает только перезапуск: пересоздание базы стирает
# узел, и ключ надо перевыпустить — иначе коннектор уходит в рестарт-петлю, а
# гость видит «управление номером недоступно» без причины.
ITV_CONNECTOR_KEY=
